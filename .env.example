# ---------------------------------------------------------------------------
# 4AB NET environment variables
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Required. SQLite for local development (the committed migrations are SQLite).
# Production uses PostgreSQL — see docs/DEPLOYMENT.md.
# Local:  file:../data/dev.db
# Supabase transaction pooler (port 6543) for runtime queries:
#   postgresql://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Supabase direct connection (port 5432) for Prisma Migrate — must NOT use the pooler:
#   postgresql://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL="file:../data/dev.db"

# Required. 32+ random bytes, base64. Used to sign order-access cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=""

# Public site origin, no trailing slash. Required for Telegram Mini App URLs.
# On Netlify this is the site URL, e.g. https://4abnet.netlify.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Supabase (production storage) -----------------------------------------
# Server-only. Leave both empty in local development to use ./public/uploads and
# ./storage/private on disk. Setting only one of them is a configuration error
# and uploads will fail loudly instead of silently writing to an ephemeral disk.
SUPABASE_URL=""
# Service-role key: bypasses row level security. Never expose it to the browser
# and never prefix it with NEXT_PUBLIC_. Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=""
# Buckets created by supabase/setup.sql.
SUPABASE_PUBLIC_BUCKET="media"
SUPABASE_PRIVATE_BUCKET="private"

# Optional. Only needed when migrations must use a different connection than the
# app (Supabase session pooler / direct connection on port 5432).
# DIRECT_URL=""

# Optional Telegram integration. Leave empty to keep the integration disabled.
# The application will show "not configured" instead of pretending it works.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_ADMIN_CHAT_ID=""
TELEGRAM_BOT_USERNAME=""

# Protects the maintenance/cron endpoint: /api/cron/maintenance
CRON_SECRET=""

# Optional. Maximum accepted upload size in MB (default 4).
# Hosted platforms cap request bodies: Netlify ~6 MB, Vercel 4.5 MB.
MAX_UPLOAD_MB="4"
